<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_chatbot-conversation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tools/generate_models.py" exporterVersion="1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Msg_CustomerMessage" name="chatbot.customer-message"><bpmn:extensionElements><zeebe:subscription correlationKey="=conversationId" /></bpmn:extensionElements></bpmn:message>
  <bpmn:error id="Error_AgentOffRail" name="Assistant off the rails" errorCode="AGENT_OFF_RAIL" />
  <bpmn:error id="Error_CardNotFound" name="Card not found" errorCode="CARD_NOT_FOUND" />
  <bpmn:process id="chatbot-conversation" name="Chatbot conversation" isExecutable="true"><bpmn:extensionElements><zeebe:executionListeners><zeebe:executionListener eventType="end" type="chatbot.closed" retries="3" /></zeebe:executionListeners></bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="Customer starts a chat"><bpmn:outgoing>f_start</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="MergeTurn"><bpmn:incoming>f_start</bpmn:incoming><bpmn:incoming>f_loop</bpmn:incoming><bpmn:outgoing>f_turn</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:adHocSubProcess id="Agent" name="Banking assistant" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="8" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,"><bpmn:documentation>Answers the customer and decides which tools to use. It can read accounts, look up fees, lock a card or open a service request after the customer confirms, ask the customer a question, and hand off to an advisor.</bpmn:documentation><bpmn:extensionElements><zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" /><zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="3" /><zeebe:ioMapping><zeebe:input source="openaiCompatible" target="provider.type" /><zeebe:input source="=camunda.vars.env.CHATBOT_LLM.endpoint" target="provider.openaiCompatible.endpoint" /><zeebe:input source="{{secrets.CHATBOT_LLM_API_KEY}}" target="provider.openaiCompatible.authentication.apiKey" /><zeebe:input source="PT30S" target="provider.openaiCompatible.timeouts.timeout" /><zeebe:input source="=camunda.vars.env.CHATBOT_LLM.model" target="provider.openaiCompatible.model.model" /><zeebe:input source="=2048" target="provider.openaiCompatible.model.parameters.maxCompletionTokens" /><zeebe:input source="=&quot;You are the digital banking assistant of Banque Exemple Boréale, a fictional Canadian retail bank used for a demo. You chat with one signed-in customer about their own accounts and cards, branch hours and fees, and service requests. Investment, tax and legal advice, credit decisions, and anything unrelated to this customer's banking are out of scope.&#10;&#10;GOAL AND SUCCESS CRITERIA&#10;Resolve the customer's request in as few turns as possible, in plain conversational language. A reply is complete only when every balance, fee, card status or reference number in it comes from a tool result in this conversation, never from memory or assumption. A change to the customer's products (locking a card, opening a service request) is complete only when the customer said yes to that exact action in this conversation and the tool result confirms it.&#10;&#10;TOOLS (you decide which to call, in what order, and how often)&#10;- GetAccountSummary: the signed-in customer's accounts, balances and cards.&#10;- LookUpBranchHoursAndFees: the bank's published branch hours and fees, by topic.&#10;- LockCard: locks one card. Changes the customer's product.&#10;- CreateServiceRequest: opens a service request and returns its reference number. Changes something.&#10;- AskCustomer: asks the customer one question in the chat and waits for the answer.&#10;- HandOffToAdvisor: sends the question to a human advisor and waits for the advisor's answer.&#10;- CloseConversation: marks the conversation as finished.&#10;&#10;APPROACH&#10;Work toward the goal, not a fixed script. If you need account or card data, get it with a tool rather than asking the customer for it. Before any action that changes something, name the exact action (for example: lock the Visa card ending 4417) and get an explicit yes, with AskCustomer if you are in the middle of a request. If the customer asks for a person, reports fraud, is upset, or asks something your tools cannot answer, hand off to an advisor and pass on the advisor's answer. When the customer says goodbye or needs nothing else, call CloseConversation and then say a short goodbye.&#10;&#10;RESTRICTIONS AND FAILURE BEHAVIOUR&#10;Never invent balances, transactions, fees, card states or reference numbers. You only see the signed-in customer; never discuss anyone else's data. If a tool fails or returns nothing useful, say so plainly and offer a service request or an advisor. Do not give investment, tax or legal advice.&#10;&#10;OUTPUT&#10;Plain conversational text for a chat window, in the customer's language (English or French). At most four short sentences, or a short list. No JSON, no markdown headings, no code blocks, and no tool names or internal ids. Write like a careful bank employee: no emoji, no exclamation marks, and no dashes between clauses; use a comma or a new sentence.&quot;" target="data.systemPrompt.prompt" /><zeebe:input source="=if is defined(followUp) and followUp != null then followUp else firstMessage" target="data.userPrompt.prompt" /><zeebe:input source="=chatAgent.context" target="agentContext" /><zeebe:input source="in-process" target="data.memory.storage.type" /><zeebe:input source="=30" target="data.memory.contextWindowSize" /><zeebe:input source="=get or else(chatAgent.context.metrics.modelCalls, 0) + 8" target="data.limits.maxModelCalls" /><zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" /><zeebe:input source="text" target="data.response.format.type" /><zeebe:input source="=false" target="data.response.includeAssistantMessage" /><zeebe:input source="=true" target="data.response.includeAgentContext" /><zeebe:input target="agent" /><zeebe:output source="=agent" target="chatAgent" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="8" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" /><zeebe:header key="retryBackoff" value="PT5S" /><zeebe:header key="errorExpression" value="=if error != null and list contains([&quot;MAXIMUM_NUMBER_OF_MODEL_CALLS_REACHED&quot;, &quot;FAILED_TO_PARSE_RESPONSE_CONTENT&quot;, &quot;MODEL_RESPONSE_CONTENT_FILTERED&quot;, &quot;MODEL_RESPONSE_GUARDRAIL_INTERVENED&quot;, &quot;MODEL_CONTEXT_WINDOW_EXCEEDED&quot;], error.code) then bpmnError(&quot;AGENT_OFF_RAIL&quot;, error.message, {agentErrorCode: error.code}) else null" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>f_turn</bpmn:incoming><bpmn:outgoing>f_reply</bpmn:outgoing>
      <bpmn:serviceTask id="GetAccountSummary" name="Get the customer's accounts and cards"><bpmn:documentation>Returns the signed-in customer's accounts (type, last four digits, balance in CAD) and cards (network, last four digits, status). Use it whenever the customer asks about a balance, an account or a card, and before locking a card so you can name the right one. It only sees the signed-in customer. No input needed.</bpmn:documentation><bpmn:extensionElements><zeebe:taskDefinition type="chatbot.accounts" retries="3" /><zeebe:executionListeners><zeebe:executionListener eventType="start" type="chatbot.progress" retries="3" /></zeebe:executionListeners><zeebe:ioMapping><zeebe:input source="=customerId" target="customerId" /><zeebe:output source="=accountSummary" target="toolCallResult" /></zeebe:ioMapping></bpmn:extensionElements></bpmn:serviceTask>
      <bpmn:businessRuleTask id="LookUpBranchHoursAndFees" name="Look up branch hours and fees"><bpmn:documentation>Returns the bank's published answer for one topic from the hours and fees table. Use it for any question about opening hours or what something costs. Quote the answer and do not add fees that are not in it. If the topic is not covered, the answer says so.</bpmn:documentation><bpmn:extensionElements><zeebe:calledDecision decisionId="branch-hours-and-fees" bindingType="deployment" resultVariable="faqAnswer" /><zeebe:executionListeners><zeebe:executionListener eventType="start" type="chatbot.progress" retries="3" /></zeebe:executionListeners><zeebe:ioMapping><zeebe:input source="=fromAi(toolCall.topic, &quot;The topic to look up&quot;, &quot;string&quot;, {enum: [&quot;branch-hours&quot;, &quot;monthly-account-fees&quot;, &quot;interac-e-transfer&quot;, &quot;atm-fees&quot;, &quot;card-replacement&quot;, &quot;international-wire&quot;, &quot;other&quot;]})" target="topic" /><zeebe:output source="={topic: topic, answer: faqAnswer}" target="toolCallResult" /></zeebe:ioMapping></bpmn:extensionElements></bpmn:businessRuleTask>
      <bpmn:serviceTask id="CreateServiceRequest" name="Open a service request"><bpmn:documentation>Opens a service request with the back office and returns its reference number. Use it when the customer wants something the bank does later: replace a card, dispute a transaction, change an address, order cheques. Confirm the request with the customer before you open it, and give the customer the reference number from the result.</bpmn:documentation><bpmn:extensionElements><zeebe:taskDefinition type="chatbot.service-request" retries="3" /><zeebe:executionListeners><zeebe:executionListener eventType="start" type="chatbot.progress" retries="3" /></zeebe:executionListeners><zeebe:ioMapping><zeebe:input source="=customerId" target="customerId" /><zeebe:input source="=fromAi(toolCall.category, &quot;Kind of request&quot;, &quot;string&quot;, {enum: [&quot;card-replacement&quot;, &quot;transaction-dispute&quot;, &quot;address-change&quot;, &quot;cheque-order&quot;, &quot;other&quot;]})" target="category" /><zeebe:input source="=fromAi(toolCall.details, &quot;One or two sentences on what the customer wants, in their words&quot;, &quot;string&quot;)" target="details" /><zeebe:output source="=serviceRequest" target="toolCallResult" /></zeebe:ioMapping></bpmn:extensionElements></bpmn:serviceTask>
      <bpmn:scriptTask id="CloseConversation" name="Close the conversation"><bpmn:documentation>Marks the conversation as finished. Use it only when the customer says goodbye or confirms they need nothing else. After calling it, reply with a short goodbye.</bpmn:documentation><bpmn:extensionElements><zeebe:script expression="={closed: true, note: &quot;Say a short goodbye.&quot;}" resultVariable="toolCallResult" /></bpmn:extensionElements></bpmn:scriptTask>
      <bpmn:serviceTask id="LockCard" name="Lock a card"><bpmn:documentation>Locks one of the customer's cards so new purchases and withdrawals are refused. Use it only after the customer said yes to locking that specific card in this conversation. Pass the last four digits from the account summary. Returns the new card status.</bpmn:documentation><bpmn:extensionElements><zeebe:taskDefinition type="chatbot.lock-card" retries="3" /><zeebe:executionListeners><zeebe:executionListener eventType="start" type="chatbot.progress" retries="3" /></zeebe:executionListeners><zeebe:ioMapping><zeebe:input source="=customerId" target="customerId" /><zeebe:input source="=fromAi(toolCall.cardLast4, &quot;Last four digits of the card to lock, from the account summary&quot;, &quot;string&quot;)" target="cardLast4" /><zeebe:input source="=fromAi(toolCall.customerConfirmed, &quot;true only if the customer explicitly said yes to locking this card&quot;, &quot;boolean&quot;)" target="customerConfirmed" /><zeebe:output source="=cardLock" target="toolCallResult" /></zeebe:ioMapping></bpmn:extensionElements></bpmn:serviceTask>
      <bpmn:boundaryEvent id="CardNotFound" name="Card not found" attachedToRef="LockCard"><bpmn:outgoing>f_nf</bpmn:outgoing><bpmn:errorEventDefinition id="ErrDef_CardNotFound" errorRef="Error_CardNotFound" /></bpmn:boundaryEvent>
      <bpmn:scriptTask id="ExplainCardNotFound" name="Explain that the card was not found"><bpmn:extensionElements><zeebe:script expression="={locked: false, reason: &quot;No card with those last four digits belongs to this customer. Check the digits with the customer.&quot;}" resultVariable="toolCallResult" /></bpmn:extensionElements><bpmn:incoming>f_nf</bpmn:incoming></bpmn:scriptTask>
      <bpmn:userTask id="HandOffToAdvisor" name="Hand off to an advisor"><bpmn:documentation>Sends the conversation to a human advisor in Tasklist and waits for the advisor's answer, then returns it. Use it when the customer asks for a person, reports fraud, is upset, or asks something the other tools cannot answer. Pass a short summary and the customer's question. Relay the advisor's answer without changing any fact in it.</bpmn:documentation><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="advisor-reply" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="advisors" /><zeebe:executionListeners><zeebe:executionListener eventType="start" type="chatbot.progress" retries="3" /></zeebe:executionListeners><zeebe:ioMapping><zeebe:input source="=fromAi(toolCall.summary, &quot;Two or three sentences on the conversation so far, for the advisor&quot;, &quot;string&quot;)" target="summaryShown" /><zeebe:input source="=fromAi(toolCall.question, &quot;The question the advisor should answer&quot;, &quot;string&quot;)" target="questionShown" /><zeebe:output source="={advisorAnswer: advisorAnswer, answeredBy: &quot;advisor&quot;}" target="toolCallResult" /></zeebe:ioMapping></bpmn:extensionElements></bpmn:userTask>
      <bpmn:subProcess id="AskCustomer" name="Ask the customer and wait for the answer"><bpmn:documentation>Sends one question to the customer in the chat, waits for the reply, and returns it. Use it to confirm an action that changes something (locking a card, opening a service request) or to get a detail you need to finish the current request. Ask one clear question.</bpmn:documentation><bpmn:extensionElements><zeebe:executionListeners><zeebe:executionListener eventType="start" type="chatbot.progress" retries="3" /></zeebe:executionListeners><zeebe:ioMapping><zeebe:input source="=fromAi(toolCall.question, &quot;One clear question for the customer&quot;, &quot;string&quot;)" target="question" /><zeebe:input source="=null" target="customerAnswer" /><zeebe:output source="={question: question, answer: customerAnswer}" target="toolCallResult" /></zeebe:ioMapping></bpmn:extensionElements>
        <bpmn:startEvent id="AskStart" name="Question needed"><bpmn:outgoing>f_ask1</bpmn:outgoing></bpmn:startEvent>
        <bpmn:serviceTask id="SendQuestion" name="Send the question"><bpmn:extensionElements><zeebe:taskDefinition type="chatbot.reply" retries="3" /><zeebe:ioMapping><zeebe:input source="=question" target="replyText" /><zeebe:input source="question" target="replyKind" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>f_ask1</bpmn:incoming><bpmn:outgoing>f_ask2</bpmn:outgoing></bpmn:serviceTask>
        <bpmn:intermediateCatchEvent id="WaitForAnswer" name="Customer answers"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="=message" target="customerAnswer" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>f_ask2</bpmn:incoming><bpmn:outgoing>f_ask3</bpmn:outgoing><bpmn:messageEventDefinition id="MsgDef_Answer" messageRef="Msg_CustomerMessage" /></bpmn:intermediateCatchEvent>
        <bpmn:endEvent id="AskEnd" name="Answer received"><bpmn:incoming>f_ask3</bpmn:incoming></bpmn:endEvent>
        <bpmn:sequenceFlow id="f_ask1" sourceRef="AskStart" targetRef="SendQuestion"></bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="f_ask2" sourceRef="SendQuestion" targetRef="WaitForAnswer"></bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="f_ask3" sourceRef="WaitForAnswer" targetRef="AskEnd"></bpmn:sequenceFlow>
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="f_nf" sourceRef="CardNotFound" targetRef="ExplainCardNotFound"></bpmn:sequenceFlow>
    </bpmn:adHocSubProcess>
    <bpmn:boundaryEvent id="OffRail" name="Assistant off the rails" attachedToRef="Agent"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="=agentErrorCode" target="agentErrorCode" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:outgoing>f_off</bpmn:outgoing><bpmn:errorEventDefinition id="ErrDef_OffRail" errorRef="Error_AgentOffRail" /></bpmn:boundaryEvent>
    <bpmn:serviceTask id="SendFallback" name="Send a polite fallback reply"><bpmn:extensionElements><zeebe:taskDefinition type="chatbot.reply" retries="3" /><zeebe:ioMapping><zeebe:input source="=&quot;I'm sorry, I can't finish this on my own. I've asked an advisor to pick up our conversation; their answer will appear here.&quot;" target="replyText" /><zeebe:input source="fallback" target="replyKind" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>f_off</bpmn:incoming><bpmn:outgoing>f_off2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="AdvisorTakeover" name="Answer the customer as an advisor"><bpmn:documentation>The assistant stopped. An advisor reads the conversation details and writes the answer that goes to the chat.</bpmn:documentation><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="advisor-reply" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="advisors" /><zeebe:ioMapping><zeebe:input source="=&quot;The assistant stopped (&quot; + get or else(agentErrorCode, &quot;unknown reason&quot;) + &quot;) for customer &quot; + customerId + &quot;.&quot;" target="summaryShown" /><zeebe:input source="=if is defined(followUp) and followUp != null then followUp else firstMessage" target="questionShown" /><zeebe:output source="=advisorAnswer" target="advisorAnswer" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>f_off2</bpmn:incoming><bpmn:outgoing>f_off3</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="SendAdvisorReply" name="Send the advisor's reply"><bpmn:extensionElements><zeebe:taskDefinition type="chatbot.reply" retries="3" /><zeebe:ioMapping><zeebe:input source="=advisorAnswer" target="replyText" /><zeebe:input source="advisor" target="replyKind" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>f_off3</bpmn:incoming><bpmn:outgoing>f_off4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="EndAdvisor" name="Handed to an advisor"><bpmn:incoming>f_off4</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="SendReply" name="Send reply"><bpmn:documentation>Pushes the assistant's answer to the customer's browser.</bpmn:documentation><bpmn:extensionElements><zeebe:taskDefinition type="chatbot.reply" retries="3" /><zeebe:ioMapping><zeebe:input source="=get or else(chatAgent.responseText, &quot;Sorry, I could not prepare an answer. Please try again.&quot;)" target="replyText" /><zeebe:input source="answer" target="replyKind" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>f_reply</bpmn:incoming><bpmn:outgoing>f_check</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwFinished" name="Conversation finished?" default="f_more"><bpmn:incoming>f_check</bpmn:incoming><bpmn:outgoing>f_done</bpmn:outgoing><bpmn:outgoing>f_more</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndClosed" name="Conversation closed"><bpmn:incoming>f_done</bpmn:incoming></bpmn:endEvent>
    <bpmn:eventBasedGateway id="WaitCustomer"><bpmn:incoming>f_more</bpmn:incoming><bpmn:outgoing>f_msg</bpmn:outgoing><bpmn:outgoing>f_quiet</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="CustomerMessage" name="Customer message"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="=message" target="followUp" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>f_msg</bpmn:incoming><bpmn:outgoing>f_loop</bpmn:outgoing><bpmn:messageEventDefinition id="MsgDef_FollowUp" messageRef="Msg_CustomerMessage" /></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Silence" name="15 minutes of silence"><bpmn:incoming>f_quiet</bpmn:incoming><bpmn:outgoing>f_timeout</bpmn:outgoing><bpmn:timerEventDefinition id="TimerDef_Silence"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="SendClosingNote" name="Tell the customer the chat closed"><bpmn:extensionElements><zeebe:taskDefinition type="chatbot.reply" retries="3" /><zeebe:ioMapping><zeebe:input source="=&quot;This chat closed after 15 minutes without a message. Start a new chat any time.&quot;" target="replyText" /><zeebe:input source="closed" target="replyKind" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>f_timeout</bpmn:incoming><bpmn:outgoing>f_timeout2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="EndTimeout" name="Conversation closed"><bpmn:incoming>f_timeout2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start" sourceRef="Start" targetRef="MergeTurn"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_turn" sourceRef="MergeTurn" targetRef="Agent"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_reply" sourceRef="Agent" targetRef="SendReply"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_check" sourceRef="SendReply" targetRef="GwFinished"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_done" name="Yes" sourceRef="GwFinished" targetRef="EndClosed"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=some m in get or else(chatAgent.context.conversation.messages, []) satisfies (some t in get or else(m.toolCalls, []) satisfies t.name = "CloseConversation")</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_more" name="No" sourceRef="GwFinished" targetRef="WaitCustomer"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_msg" sourceRef="WaitCustomer" targetRef="CustomerMessage"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_quiet" sourceRef="WaitCustomer" targetRef="Silence"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_loop" name="Next turn" sourceRef="CustomerMessage" targetRef="MergeTurn"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_timeout" sourceRef="Silence" targetRef="SendClosingNote"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_timeout2" sourceRef="SendClosingNote" targetRef="EndTimeout"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_off" sourceRef="OffRail" targetRef="SendFallback"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_off2" sourceRef="SendFallback" targetRef="AdvisorTakeover"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_off3" sourceRef="AdvisorTakeover" targetRef="SendAdvisorReply"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_off4" sourceRef="SendAdvisorReply" targetRef="EndAdvisor"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_chatbot-conversation">
    <bpmndi:BPMNPlane id="Plane_chatbot-conversation" bpmnElement="chatbot-conversation">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="100" y="312" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="68.0" y="352" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MergeTurn_di" bpmnElement="MergeTurn"><dc:Bounds x="180" y="305" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Agent_di" bpmnElement="Agent" isExpanded="true"><dc:Bounds x="280" y="80" width="720" height="500" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GetAccountSummary_di" bpmnElement="GetAccountSummary"><dc:Bounds x="320" y="130" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LookUpBranchHoursAndFees_di" bpmnElement="LookUpBranchHoursAndFees"><dc:Bounds x="480" y="130" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CreateServiceRequest_di" bpmnElement="CreateServiceRequest"><dc:Bounds x="640" y="130" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CloseConversation_di" bpmnElement="CloseConversation"><dc:Bounds x="800" y="130" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LockCard_di" bpmnElement="LockCard"><dc:Bounds x="320" y="270" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CardNotFound_di" bpmnElement="CardNotFound"><dc:Bounds x="357" y="332" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="325" y="394" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExplainCardNotFound_di" bpmnElement="ExplainCardNotFound"><dc:Bounds x="480" y="270" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HandOffToAdvisor_di" bpmnElement="HandOffToAdvisor"><dc:Bounds x="640" y="270" width="110" height="80" /></bpmndi:BPMNShape>
